function visualise_ellipses(map, env_shape)

if strcmp(env_shape, 'rectangle')
    try
    % Divide map into 3x3 blocks
    [rows, cols] = size(map);
    row_blocks = round([rows/3, rows/3, rows - 2*round(rows/3)]);
    col_blocks = round([cols/3, cols/3, cols - 2*round(cols/3)]);
    mini_maps = mat2cell(map, row_blocks, col_blocks);

    % Compute SACs for each bin
    binned_sac = cellfun(@xPearson, mini_maps, 'UniformOutput', false);

    % plt sacs and fitted elipses
    figure;
    tiledlayout(3,3, 'Padding','none')
    % Compute metrics for each bin
    for i = 1:3
        for j = 1:3
            ax = nexttile;
            sac = binned_sac{i,j};
            imagesc(sac);hold on;
            [~, ~, ~, ~, ~] = gridEllipse_fit(sac, true);
            axis equal tight
            ax.XTick = [];
            ax.YTick = [];
            ax.XColor = 'none';
            ax.YColor = 'none';
        end
    end
    catch
    end
elseif strcmp(env_shape, 'trapezoid')
    try
    % Remove median values
    rotated_map = rot90(map, 1);
    map_median = median(rotated_map(~isnan(rotated_map)), 'all');
    rotated_map(rotated_map == map_median) = NaN;

    % Count non-NaN values and compute half
    non_nan_count = sum(~isnan(rotated_map), 'all');
    half_count = non_nan_count / 2;

    % Find vertical split (column) for equal non-NaNs
    [rows, cols] = size(rotated_map);
    cumulative_col_count = zeros(cols, 1);
    for j = 1:cols
        cumulative_col_count(j) = sum(~isnan(rotated_map(:, 1:j)), 'all');
    end
    [~, split_col] = min(abs(cumulative_col_count - half_count));

    % Split rotated_map into two vertical blocks (left and right)
    col_blocks = [split_col, cols - split_col];
    mini_maps = mat2cell(rotated_map, rows, col_blocks);

    % Compute SACs for each bin
    binned_sac = cellfun(@xPearson, mini_maps, 'UniformOutput', false);
   
    % plt sacs and fitted elipses
    figure;
    tiledlayout(1,2, 'Padding','none')
    % Compute metrics for each bin
    for i = 1:2
        ax = nexttile;
        sac = binned_sac{i};
        imagesc(sac);hold on;
        [~, ~, ~, ~, ~] = gridEllipse_fit(sac, true);
        axis equal tight
        ax.XTick = [];
        ax.YTick = [];
        ax.XColor = 'none';
        ax.YColor = 'none';
        hold on;
        [x, y] = isnan(sac);
        plot(x, y, 'w.')
    end
    catch 
    end
end

end

