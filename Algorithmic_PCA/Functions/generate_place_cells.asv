function [PlaceCells, In.env] = generate_place_cells(In, pc_density, pc_size)
    % generate place cells with option for place field size varied and
    % densiy varied
    %  if both are set to true - you get standard tanni cells
    %  if both are set to false - you get standard uniform cells
    %  you can do one but not the other to check what aspect of the plac
    %  cells (difference in distribution density or difference in size) is
    %  actually having na effect on the resuling grid fie
    
    if ~pc_density  
        [xy_field, In.env] = getPlaceFieldCentres(In.env, In.n_cells, In.dim_x, In.dim_y, 1000);
    else
        [xy_field, In.env] = getPlaceFieldCentres(In.env, In.n_cells, In.dim_x, In.dim_y, In.boundary_effect);
    end 

    if ~pc_size % place field sizes dont vary with distance to boundary
        av_bound_dist = nanmean(env.dwmap, 'all');
        fw = fieldWidth(av_bound_dist) / In.pf_width_cntrl; % field width for uniform 
        PlaceCells = generateUniformPCs(In.env, In.n_cells, xy_field, fw);
    else % place field sizes do vary
        PlaceCells = generateSanderPCs(In.env, In.n_cells, xy_field); 
    end

    % plot place field centres 
    % figure; 
    % subplot(1, 2, 1); plot(xy_field_u(:,1), xy_field_u(:,2), '.', 'MarkerSize', 15); hold on;
    % subplot(1, 2, 2); plot(xy_field_t(:,1), xy_field_t(:,2), '.', 'MarkerSize', 15);

end

