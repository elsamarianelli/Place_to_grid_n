function [Position, Direction] = HasselmoForage(env, n_steps, thigmo_factor)
%HASSELMOFORAGE Generates a foraging trajectory with optional thigmotaxis.
%
%   INPUTS:
%       env            - Environment structure (must contain env.L and env.dim_x/y)
%       n_samples      - Number of time steps for the trajectory
%       thigmo_factor  - Strength of thigmotaxis (0 = random, 1 = strong wall-following)
%
%   OUTPUTS:
%       Position  - (n_samples x 2) array of x,y positions over time
%       Direction - (n_samples x 1) vector of heading directions

%% **Initialize Parameters**
mu = 0;             % Mean of random turn angle
sigma = 0.2;        % Standard deviation of random turn
b = 16;             % Rayleigh distribution scale for velocity
v = 20;             % Initial velocity
Dir = rand * 2 * pi; % Initial heading direction
dt = 1 / 50;        % Time step (50 Hz)

% Generate random velocity and turn samples
RandomTurn = normrnd(mu, sigma, [1, n_steps]);  % Gaussian turn angles
RandomVel = min(raylrnd(b, [1, n_steps]), 49);  % Rayleigh-distributed speeds

%% **Initialize Position and Direction Storage**
Position = zeros(n_steps, 2);
Direction = zeros(n_steps, 1);

% Choose a random **valid starting position**
start = datasample(find(env.L == 2), 1); % Pick a position in a valid area
[j, i] = ind2sub([env.dim_y, env.dim_x], start);
Position(1, :) = [i, j]; % Store initial position
Direction(1) = Dir; % Store initial direction

%% **Foraging Loop**
for step = 2:n_samples
    % Get distance and angle to the nearest wall
    [dWall, aWall] = minDistAngle(env, round(Position(step-1, :)), Dir);
    
    % Set velocity from the precomputed random velocity
    v = RandomVel(step);

    % **Thigmotaxis Behavior** - Adjust Movement Based on Wall Proximity
    if (dWall < 7 && abs(aWall) < pi/2)  % Close to a wall and facing it
        angle = sign(aWall) * (pi/2 - abs(aWall)) + RandomTurn(step); % Turn along the wall
        v = v - 0.5 * max([0, (v - 5)]); % Slow down near walls
    else
        angle = RandomTurn(step); % Normal random turn
    end

    % **Introduce Thigmotaxis: Bias Toward Walls**
    if thigmo_factor > 0
        if dWall > 10 % If far from the wall, turn slightly toward it
            angle = angle - thigmo_factor * sign(aWall) * (pi/6); % Bias turn toward wall
        elseif dWall < 5 % If too close, turn slightly away
            angle = angle + thigmo_factor * sign(aWall) * (pi/6);
        end
    end

    % **Move the Agent**
    Position(step, :) = Position(step-1, :) + v * dt * [cos(-Dir), sin(-Dir)];

    % **Boundary Check: Keep Position Inside Valid Area**
    if (env.L(round(Position(step, 2)), round(Position(step, 1))) ~= 2)
        Position(step, :) = Position(step-1, :); % Stop at the boundary
    end

    % **Update Direction**
    Dir = Dir + angle;
    Direction(step) = Dir;
end

%% **Plot the Generated Trajectory**
figure;
imagesc(~env.map'); % Show environment map (flipped for visibility)
colormap gray;
hold on;
plot(Position(:, 2), Position(:, 1), 'LineWidth', 2); % Plot trajectory
title(sprintf('Foraging Path (Thigmotaxis = %.1f, Time = %.2f mins)', thigmo_factor, n_samples / (60 * 50)));

% Set plot appearance
axis tight;
set(gcf, 'Color', 'w');
set(gca, 'FontSize', 16);
set(gcf, 'Position', [100, 100, 800, 800]);

end
