function [Position, Direction] = HasselmoForage_varyingTrajTypes(env, n_steps, b)
%% Generates a foraging trajectory with adjustable mean speed.
%
%   INPUTS:
%       env        - Structure containing the environment (env.L, env.dim_x, env.dim_y)
%       n_steps    - Number of time steps
%       b          - Rayleigh scale parameter controlling average speed
%
%   OUTPUTS:
%       Position   - (n_steps x 2) matrix of x, y positions over time
%       Direction  - (n_steps x 1) vector of agent's heading directions

%% Initialize movement parameters
mu    = 0;        % Mean of turn angle
sigma = 0.2;      % Std dev of turning
dt    = 1 / 50;   % Time step (50 Hz update rate)
Dir   = rand * 2 * pi;  % Initial random direction

% Pre-generate movement randomness
RandomTurn = normrnd(mu, sigma, [1, n_steps]);    % Turning samples
RandomVel  = min(raylrnd(b, [1, n_steps]), 49);    % Velocity samples (Rayleigh-distributed)

%% Initialize output
Position  = zeros(n_steps, 2);
Direction = zeros(n_steps, 1);

% Start at a valid random location
start_idx = datasample(find(env.L == 2), 1);
[j, i]     = ind2sub([env.dim_y, env.dim_x], start_idx);
Position(1,:) = [i, j];
Direction(1)  = Dir;

%% Foraging Loop
for step = 2:n_steps
    [dWall, aWall] = minDistAngle(env, round(Position(step-1,:)), Dir);
    v = RandomVel(step);

    % Wall avoidance
    if dWall < 7 && abs(aWall) < pi/2
        angle = sign(aWall) * (pi/2 - abs(aWall)) + RandomTurn(step);
        v = v - 0.5 * max([0, (v - 5)]);

    elseif dWall > 20

        % Far from wall → very slight bias toward wall
        angle = -0.1 * aWall + RandomTurn(step);  % 0.1 is a gentle bias factor


    else
        angle = RandomTurn(step);

    end

    % Update position
    Position(step,:) = Position(step-1,:) + v * dt * [cos(-Dir), sin(-Dir)];

    % Boundary check
    if env.L(round(Position(step,2)), round(Position(step,1))) ~= 2
        Position(step,:) = Position(step-1,:);
    end

    % Update direction
    Dir = Dir + angle;
    Direction(step) = Dir;
end

%% Plot result
figure;
imagesc(~env.map'); colormap gray; axis xy; hold on;
plot(Position(:,2), Position(:,1), 'r-', 'LineWidth', 2);
title(sprintf('Foraging Path (Time = %.2f mins, b = %.1f)', n_steps / (60 * 50), b));
axis tight;
set(gca, 'FontSize', 16);
set(gcf, 'Color', 'w', 'Position', [100, 100, 800, 800]);

end
