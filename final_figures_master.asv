%% [1] Load Place and Grid Cell Data

folder = '/Users/Elsa Marianelli/Documents/';
sub = 'grids_data_trajectory_comparison';
folder = [folder sub '/'];
basename = 'data_covar_hasselmo_densityConstant_sizeVaried_widthControled';
nIterations = 5;

[Info, Place_cells, Grid_cells] = load_SR_or_covar_data(folder, basename, nIterations);

% Create subfolder for saving figures
subfolder = fullfile([sub '_figs'], basename);
if ~exist(subfolder, 'dir')
    mkdir(subfolder);
end

%% [2] Visualise Place Cell Centre Distribution

fmaps = cellfun(@(pc) pc.fmap, Place_cells, 'UniformOutput', false);
linear_idx = cellfun(@(f) find(f == max(f(:)), 1), fmaps);
[rows, cols] = cellfun(@(f, idx) ind2sub(size(f), idx), fmaps, num2cell(linear_idx));

figure; hold on;
plot(cols, rows, 'o', 'MarkerSize', 10, 'Color', 'k', 'MarkerFaceColor', 'k');

xlim tight; ylim tight;
xLimits = xlim; yLimits = ylim;
x_thirds = xLimits(1) + diff(xLimits) * [1/3, 2/3];
y_thirds = yLimits(1) + diff(yLimits) * [1/3, 2/3];

for x = x_thirds
    xline(x, '--', 'Color', [0.5 0.5 0.5], 'LineWidth', 6);
end
for y = y_thirds
    yline(y, '--', 'Color', [0.5 0.5 0.5], 'LineWidth', 6);
end

axis equal;
set(gca, 'Box', 'on', 'FontSize', 25);
saveas(gcf, fullfile(subfolder, 'Figure_A_place_centres.svg'));

%% [3] Visualise Example Place Cells

figure;
for i = 1:10
    map = Place_cells{i*6}.fmap;
    subplot(2, 5, i); imagesc(map); colormap("jet");
    axis off; axis image;
end
saveas(gcf, fullfile(subfolder, 'Figure_B_place.svg'));

%% [4] Visualise Example Grid Cells

figure;
for i = 1:40
    map = Grid_cells{1}{i*3}.map;
    subplot(4, 10, i); imagesc(map); colormap("jet");
    axis off; axis image;
end
saveas(gcf, fullfile(subfolder, 'Figure_B_grid.svg'));

%% [5] Compute Grid Cell Metrics in Environment Bins
shape = 'hexagon';
nIterations = numel(Grid_cells);
nPCs = numel(Grid_cells{1});
metrics_all = cell(nIterations, nPCs);

parfor iter = 1:nIterations
    for pc = 1:nPCs
        map = Grid_cells{iter}{pc}.map;
        smoothed_map = smoothdata(map);
        peaks = FastPeakFind(smoothed_map);

        if numel(peaks)/2 > 30
            try
                [~, binned_three, binned_nine, binned_variability] = get_binned_metrics(map, shape);
                if any(arrayfun(@(x) any(isnan(x.scale_h)), binned_three))
                    metrics_all{iter, pc} = [];
                else
                    metrics_all{iter, pc}.three       = binned_three;
                    metrics_all{iter, pc}.nine        = binned_nine;
                    metrics_all{iter, pc}.variability = binned_variability;
                    fprintf("Metrics saved for iter %d, PC %d\n", iter, pc);
                end
            catch
                metrics_all{iter, pc} = [];
            end
        end
    end
end
%% [6] Bar Chart Summary of Grid Metrics + Variability Across Regions

metrics = {'expGrd_h_el', 'scale_h', 'eccent', 'orient'};
metric_titles = {'Gridness', 'Scale', 'Eccentricity', 'Orientation'};

ylim_map = struct( ...
    'expGrd_h_el', [.2 0.5], ...
    'scale_h',  [40 60], ...
    'eccent',   [0.5 0.8], ...
    'orient',   [0 90] ...
);

bar_colors_main = {[.8 .8 .8], [0.5 0.5 .5], [.3 .3 .3]};
bar_colors_var  = {[0.6 0.8 1], [0.3 0.5 0.8], [0.1 0.3 0.6]};
xtick_labels = {'Corners', 'Edges', 'Center'};
region_count = numel(xtick_labels);
threshold = 0.5;

nIterations = size(metrics_all, 1);
nPCs = size(metrics_all, 2);

% === Create double-width tiled layout (metric + variability)
fig = figure('Units', 'inches', 'Position', [1 1 2 * numel(metrics) * 3, 3]);
tiledlayout(1, numel(metrics)*2, 'TileSpacing', 'compact', 'Padding', 'compact');

for m = 1:numel(metrics)
    metric = metrics{m};
    title_str = metric_titles{m};

    % --- Storage for primary metric and variability
    vals_all = nan(nIterations, region_count);
    var_all  = nan(nIterations, region_count);

    % --- Loop through iterations
    for iter = 1:nIterations
        vals = nan(nPCs, region_count);
        vars = nan(nPCs, region_count);

        for pc = 1:nPCs
            data = metrics_all{iter, pc};

            if isstruct(data) && isfield(data, 'three')
                try
                    % --- Metric values (e.g. gridness, scale, etc.)
                    tbl = struct2table(data.three);
                    if ismember(metric, tbl.Properties.VariableNames)
                        vals(pc, :) = tbl.(metric)';
                    end

                    % --- Variability (direct from precomputed variability struct)
                    if isfield(data, 'variability')
                        var_tbl = struct2table(data.variability);
                        if ismember(metric, var_tbl.Properties.VariableNames)
                            vars(pc, :) = var_tbl.(metric)';
                        end
                    end
                catch
                end
            end
        end

        % Aggregate across PCs
        if strcmp(metric, 'expGrd_h_el')
            vals_all(iter, :) = mean(vals > threshold, 'omitnan');
        else
            vals_all(iter, :) = mean(vals, 1, 'omitnan');
        end

        var_all(iter, :) = mean(vars, 1, 'omitnan');
    end


    % --- Aggregate metrics across iterations
    grand_mean = mean(vals_all, 1, 'omitnan');
    grand_std  = std(vals_all, 0, 1, 'omitnan');
    var_mean   = mean(var_all, 1, 'omitnan');
    var_std    = std(var_all, 0, 1, 'omitnan');

    %% === Plot Main Metric ===
    nexttile;
    hold on;
    bar_x = 1:region_count;

    for i = 1:region_count
        bar(bar_x(i), grand_mean(i), 'FaceColor', bar_colors_main{i}, ...
            'EdgeColor', 'k', 'BarWidth', 0.8, 'LineWidth', 1.5);
    end

    errorbar(bar_x, grand_mean, grand_std, 'k', ...
        'LineStyle', 'none', 'LineWidth', 2);

    set(gca, 'XTick', bar_x, 'XTickLabel', xtick_labels, ...
        'FontSize', 18, 'LineWidth', 1.5, ...
        'TickDir', 'out', 'Box', 'off');

    ylim(ylim_map.(metric));
    title(title_str, 'FontSize', 20);

    % Y-label only on first metric
    if m == 1
        switch metric
            case 'expGrd_h_el'
                ylabel(['Proportion > ', num2str(threshold)], 'FontSize', 18);
            case 'scale_h'
                ylabel('Bins', 'FontSize', 18);
            case 'orient'
                ylabel('Degrees', 'FontSize', 18);
            otherwise
                ylabel(title_str, 'FontSize', 18);
        end
    end

    %% === Plot Variability ===
    nexttile;
    hold on;

    for i = 1:region_count
        bar(bar_x(i), var_mean(i), 'FaceColor', bar_colors_var{i}, ...
            'EdgeColor', 'k', 'BarWidth', 0.8, 'LineWidth', 1.5);
    end

    errorbar(bar_x, var_mean, var_std, 'k', ...
        'LineStyle', 'none', 'LineWidth', 2);

    set(gca, 'XTick', bar_x, 'XTickLabel', xtick_labels, ...
        'FontSize', 18, 'LineWidth', 1.5, ...
        'TickDir', 'out', 'Box', 'off');

    ylim([0 max(0.1, max(var_mean + var_std, [], 'omitnan')) * 1.2]);
    title(['Variability'], 'FontSize', 20);

    if m == 1
        ylabel('Norm. Abs Deviation', 'FontSize', 18);
    end
end

% Save figure
saveas(fig, fullfile(subfolder, 'Barchart_Metrics_And_Variability_n.svg'));

